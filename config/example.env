# Copy to a local untracked env file only after approval.

HELIO_ENV=development
HELIO_BIND_HOST=127.0.0.1
HELIO_PORT=8787

# Optional, do not fill with real secrets in this example file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_TOKEN_FILE=
GOOGLE_OAUTH_SCOPES=
GOOGLE_AUDIT_LOG=logs/google_workspace_audit.jsonl
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
OLLAMA_HOST=http://127.0.0.1:11434
TAILSCALE_HOSTNAME=

# Private Gemma4 worker endpoint on DevMonster.
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=
GEMMA_TIMEOUT=30

# Helio model router.
DEVMONSTER_OLLAMA_URL=http://100.93.120.124:11434
DEVMONSTER_DEFAULT_MODEL=gemma4:26b
FAST_LOCAL_MODEL=gemma3:4b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase agent bus read-only scaffold placeholders.
# Do not put real secrets in this example file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HELIO_AGENT_BUS_MODE=read_only
HELIO_DEFAULT_ORG=msr
HELIO_DEFAULT_WORKSPACE=default
HELIO_AGENT_ID=hermes
