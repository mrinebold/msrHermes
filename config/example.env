# Copy to a local untracked env file only after approval.

HELIO_ENV=development
HELIO_BIND_HOST=127.0.0.1
HELIO_PORT=8787

# Optional, do not fill with real secrets in this example file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
OLLAMA_HOST=http://127.0.0.1:11434
TAILSCALE_HOSTNAME=

# Private Gemma4 worker endpoint on DevMonster.
GEMMA_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL=
GEMMA_TIMEOUT=30
