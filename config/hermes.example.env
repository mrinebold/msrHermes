# Hermes example environment
# Copy only non-secret settings into an untracked local file after approval.
# Never put real credentials, tokens, OAuth files, or production database keys here.

# Hermes runtime home. Leave unset to use the official default ~/.hermes.
HERMES_HOME=

# Browser gateway token remains local and untracked:
# ~/Library/Application Support/Helio/hermes-gateway/token
# No public URL or Tailscale Funnel is approved.

# Private first-pilot model route. Hermes reaches the local adapter only;
# the adapter is foreground/manual and reaches the private DevMonster worker.
MODEL_ROUTER_ADAPTER_HOST=127.0.0.1
MODEL_ROUTER_ADAPTER_PORT=8088
DEVMONSTER_OLLAMA_URL=http://100.93.120.124:11434
DEVMONSTER_DEFAULT_MODEL=gemma4:26b
MODEL_ROUTER_PROVIDER_TIMEOUT_SECONDS=120
# Cloud fallbacks remain disabled for the first pilot.

# Phase 1 Hermes-to-Helio contract bridge. This is an in-process test gateway,
# not a URL to a real host. It permits scoped read fixtures and dry-run
# proposals only; it never contacts Supabase or dispatches work.
HELIO_AGENT_BUS_MODE=disabled
HELIO_GATEWAY_URL=
HERMES_HELIO_TEST_GATEWAY=0
HELIO_DEFAULT_ORG=msr
HELIO_DEFAULT_WORKSPACE=default
HELIO_AGENT_ID=hermes

# The following integrations remain unprovisioned until their approved phase.
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_TOKEN_FILE=
GOOGLE_OAUTH_SCOPES=
HASS_URL=
HASS_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
