# Hermes example env for Helio Phase 5B planning.
# Copy values to a real untracked Hermes env file only after approval.
# Do not put real secrets in this file.

# Proposed Hermes runtime home. Leave unset to use the official default ~/.hermes.
HERMES_HOME=

# Helio gateway endpoints, to be implemented before governed Hermes integration.
HELIO_GATEWAY_URL=http://127.0.0.1:8787
HELIO_MODEL_ROUTER_URL=http://127.0.0.1:8787/v1
HELIO_DISPATCHER_MCP_URL=http://127.0.0.1:8787/mcp

# DevMonster private model worker. Prefer routing through Helio model router.
DEVMONSTER_OLLAMA_URL=http://100.93.120.124:11434
DEVMONSTER_OPENAI_BASE_URL=http://100.93.120.124:11434/v1
DEVMONSTER_DEFAULT_MODEL=gemma4:26b
FAST_LOCAL_MODEL=gemma3:4b
GEMMA_TIMEOUT=30

# Hermes terminal defaults. Use config.yaml as the source of truth after install.
TERMINAL_BACKEND=local
TERMINAL_TIMEOUT=60

# Google Workspace remains disabled until explicit approval.
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_TOKEN_FILE=
GOOGLE_OAUTH_SCOPES=

# Home Assistant remains disabled until explicit approval.
# Setting HASS_TOKEN in Hermes auto-enables Home Assistant tooling, so keep blank.
HASS_URL=
HASS_TOKEN=

# GitHub writes remain disabled until explicit approval.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Supabase task bus remains disabled until explicit approval.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HELIO_AGENT_BUS_MODE=disabled
HELIO_DEFAULT_ORG=msr
HELIO_DEFAULT_WORKSPACE=default

# Optional future web/tool providers. Keep blank unless separately approved.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
